# ═══════════════════════════════════════════════════════════════
# PyBot — Python Learning Assistant
# .gitignore
# ═══════════════════════════════════════════════════════════════

# ── SECRETS — NEVER commit these ──────────────────────────────
.env
.env.local
.env.production
.env.staging
*.key
*.pem
secrets.json
credentials.json

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
build/
dist/
eggs/
*.egg-info/
*.egg
.eggs/

# ── Python Virtual Environments ───────────────────────────────
venv/
env/
ENV/
.venv/
.env/
virtualenv/
.virtualenv/

# ── Node / npm (if any tooling is added later) ────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
.npm/

# ── Operating System ──────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Windows
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ── Editors & IDEs ────────────────────────────────────────────
# VS Code
.vscode/
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.#*

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/
pip-log.txt
pip-delete-this-directory.txt

# ── Testing & Coverage ────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage/
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover

# ── Flask / Backend ───────────────────────────────────────────
instance/
.webassets-cache
flask_session/

# ── Miscellaneous ─────────────────────────────────────────────
*.bak
*.tmp
*.temp
.cache/
tmp/
temp/
